---
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  current?: string;
  image?: string;
}

const { title, description, path, current = '', image = '/og-image.jpg' } = Astro.props;
const site = Astro.site ?? new URL('https://courtsabove.com');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#315682">
<meta property="og:site_name" content="CourtsAbove">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_AU">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="CourtsAbove logo over a soft blue sky">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogImage}>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div style="font-family: 'Hanken Grotesk', 'Helvetica Neue', Helvetica, sans-serif; color: #16191D; background: #F3F2EE; min-height: 100vh; font-size: 17px; line-height: 1.6">
<header class="site-header" data-header>
<nav aria-label="Main" style="max-width: 1200px; margin: 0 auto; padding: 14px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px">
<a href="/" aria-label="CourtsAbove home" class="logolink" data-logo style="position: relative; display: flex; align-items: center; min-height: 44px"><span class="lf" aria-hidden="true"><span class="src"><span class="rays"></span><span class="core"></span><span class="beam"></span></span></span><span class="lw"><img class="logoimg" src="/images/logo-white.png" alt="CourtsAbove" style="height: 40px; width: auto; display: block"></span></a>
<button type="button" class="menubtn" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-menu-btn style="display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: #FFFFFF; cursor: pointer"><svg class="ic-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg><svg class="ic-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg></button>
<div id="site-nav" class="navlinks" style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px">
<a href="/" class="navlink" aria-current={current === 'home' ? 'page' : undefined} style={`color: #FFFFFF; text-decoration: none; font-size: 15px; letter-spacing: 0.04em; padding: 12px 4px; border-bottom: 1px solid ${current === 'home' ? '#FFFFFF' : 'transparent'}`}>Home</a>
<a href="/about/" class="navlink" aria-current={current === 'about' ? 'page' : undefined} style={`color: #FFFFFF; text-decoration: none; font-size: 15px; letter-spacing: 0.04em; padding: 12px 4px; border-bottom: 1px solid ${current === 'about' ? '#FFFFFF' : 'transparent'}`}>About</a>
<a href="/songs/" class="navlink" aria-current={current === 'songs' ? 'page' : undefined} style={`color: #FFFFFF; text-decoration: none; font-size: 15px; letter-spacing: 0.04em; padding: 12px 4px; border-bottom: 1px solid ${current === 'songs' ? '#FFFFFF' : 'transparent'}`}>Songs</a>
<a href="/resources/" class="navlink" aria-current={current === 'resources' ? 'page' : undefined} style={`color: #FFFFFF; text-decoration: none; font-size: 15px; letter-spacing: 0.04em; padding: 12px 4px; border-bottom: 1px solid ${current === 'resources' ? '#FFFFFF' : 'transparent'}`}>Resources</a>
<a href="/contact/" class="navlink" aria-current={current === 'contact' ? 'page' : undefined} style={`color: #FFFFFF; text-decoration: none; font-size: 15px; letter-spacing: 0.04em; padding: 12px 4px; border-bottom: 1px solid ${current === 'contact' ? '#FFFFFF' : 'transparent'}`}>Contact</a>
</div>
</nav>
</header>
<main id="main">
<slot />
</main>
<footer style="background: #16191D; color: #C9CCD1">
<div style="max-width: 1200px; margin: 0 auto; padding: 64px 24px 40px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 18px; max-width: 100%">
<img src="/images/logo-white.png" alt="CourtsAbove" style="height: 56px; width: auto; align-self: flex-start">
<p class="fq" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-style: italic; font-size: 18px; line-height: 1.5; letter-spacing: 0; color: #FFFFFF">For a day in your courts is better than a thousand elsewhere.</p>
<p style="margin: 0; align-self: flex-end; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-style: italic; font-size: 15px; color: #C9CCD1">— Psalm 84:10</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 56px">
<div style="display: flex; flex-direction: column; gap: 10px">
<p style="margin: 0 0 6px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #9AA0A8">Explore</p>
<a href="/about/" class="flink" style="color: #FFFFFF; text-decoration: none">About</a>
<a href="/songs/" class="flink" style="color: #FFFFFF; text-decoration: none">Songs</a>
<a href="/resources/" class="flink" style="color: #FFFFFF; text-decoration: none">Resources</a>
<a href="/contact/" class="flink" style="color: #FFFFFF; text-decoration: none">Contact</a>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<p style="margin: 0 0 6px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #9AA0A8">Follow</p>
<a href="https://open.spotify.com/album/54NkoKS9BHUDUuUEyp94kJ" class="flink" style="color: #FFFFFF; text-decoration: none; display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M7.5 9.5c3-1 6.5-.7 9 .8"></path><path d="M8 12.6c2.5-.7 5.3-.4 7.3.8"></path><path d="M8.6 15.4c2-.5 4-.3 5.6.6"></path></svg><span>Spotify</span></a>
<a href="https://youtu.be/uxvD8k9mskU" class="flink" style="color: #FFFFFF; text-decoration: none; display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg><span>YouTube</span></a>
<a href="https://www.instagram.com/courtsabove" class="flink" style="color: #FFFFFF; text-decoration: none; display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6"></circle></svg><span>Instagram</span></a>
<a href="https://www.facebook.com/CourtsAbove" class="flink" style="color: #FFFFFF; text-decoration: none; display: flex; align-items: center; gap: 10px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path></svg><span>Facebook</span></a>
</div>
</div>
</div>
<div style="max-width: 1200px; margin: 0 auto; padding: 20px 24px 32px; border-top: 1px solid #2C3137; font-size: 13px; color: #9AA0A8">© CourtsAbove · Sydney, Australia</div>
</footer>
</div>
<script>
  import '../scripts/site.js';
</script>
</body>
</html>
