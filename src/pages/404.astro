---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · CourtsAbove" description="This page could not be found." path="/404/">
<meta name="robots" content="noindex" slot="head" />
<section style="background: #16191D; color: #FFFFFF; min-height: 70vh; display: flex; align-items: center">
<div style="max-width: 1200px; margin: 0 auto; padding: 140px 24px 96px; width: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px">
<h1 style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2.4rem, 5vw, 4.2rem); line-height: 1.15">This page has wandered off.</h1>
<p style="margin: 0; font-size: 19px; color: #C9CCD1">The link may be old, or the page may have moved.</p>
<p style="margin: 8px 0 0"><a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; background: #FFFFFF; color: #16191D; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500">Back to home</a></p>
</div>
</section>
</Base>
