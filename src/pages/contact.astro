---
import Base from '../layouts/Base.astro';
---
<Base title="Contact · CourtsAbove" description="Questions, or want to collaborate on a song? Get in touch with CourtsAbove by email, Instagram or Facebook." path="/contact/" current="contact">
<section class="hero" aria-labelledby="contact-h" style="position: relative; min-height: 600px; display: flex; align-items: stretch; overflow: hidden; background: #16191D">
<img src="/images/contact-hero.jpg" alt="Golden light over a Sydney beach" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%">
<div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,14,20,0.22) 0%, rgba(10,14,20,0.28) 50%, rgba(10,14,20,0.5) 100%)"></div>
<div class="heroin" style="position: relative; max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; width: 100%; box-sizing: border-box; min-height: 600px; padding-top: 96px; padding-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 36px">
<figure style="margin: auto 0; max-width: 100%; display: flex; flex-direction: column; gap: 18px">
<h1 id="contact-h" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2rem, 3.6vw, 3.5rem); line-height: 1.2; letter-spacing: -0.015em; text-align: center; color: #FFFFFF; text-shadow: 0 2px 28px rgba(10,14,20,0.45)">Contact Us!</h1>
</figure>
</div>
</section>

<section aria-label="Get in touch" style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 88px; padding-bottom: 112px">
<div style="max-width: 680px; margin: 0 auto">
<div style="display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0 0 0 -0.055em; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.12; letter-spacing: -0.015em">Reach Us Here:</h2>
<p style="margin: -6px 0 14px; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: 19px; line-height: 1.5; letter-spacing: -0.01em; color: #5A5F66">If you have any questions or want to collaborate with us, we’d love to hear from you.</p>
<a href="mailto:courtsabove@gmail.com" class="card" style="display: flex; align-items: center; gap: 16px; min-height: 72px; padding: 16px 20px; border: 1px solid #D9D6CE; border-radius: 6px; background: #FFFFFF; color: #16191D; text-decoration: none">
<span style="width: 44px; height: 44px; border-radius: 999px; background: #F3F2EE; display: flex; align-items: center; justify-content: center; color: #2F5683; flex-shrink: 0"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
<span style="display: flex; flex-direction: column; min-width: 0"><span style="font-weight: 500">Email</span><span style="font-size: 14px; color: #5A5F66; overflow-wrap: anywhere">courtsabove@gmail.com</span></span></a>
<a href="https://www.instagram.com/courtsabove" class="card" style="display: flex; align-items: center; gap: 16px; min-height: 72px; padding: 16px 20px; border: 1px solid #D9D6CE; border-radius: 6px; background: #FFFFFF; color: #16191D; text-decoration: none">
<span style="width: 44px; height: 44px; border-radius: 999px; background: #F3F2EE; display: flex; align-items: center; justify-content: center; color: #2F5683; flex-shrink: 0"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6"></circle></svg></span>
<span style="display: flex; flex-direction: column; min-width: 0"><span style="font-weight: 500">Instagram</span><span style="font-size: 14px; color: #5A5F66; overflow-wrap: anywhere">@courtsabove</span></span></a>
<a href="https://www.facebook.com/CourtsAbove" class="card" style="display: flex; align-items: center; gap: 16px; min-height: 72px; padding: 16px 20px; border: 1px solid #D9D6CE; border-radius: 6px; background: #FFFFFF; color: #16191D; text-decoration: none">
<span style="width: 44px; height: 44px; border-radius: 999px; background: #F3F2EE; display: flex; align-items: center; justify-content: center; color: #2F5683; flex-shrink: 0"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path></svg></span>
<span style="display: flex; flex-direction: column; min-width: 0"><span style="font-weight: 500">Facebook</span><span style="font-size: 14px; color: #5A5F66; overflow-wrap: anywhere">facebook.com/CourtsAbove</span></span></a>
</div>
</div>
</section>
</Base>
<style is:global>
@media (max-width: 760px){
.menubtn{display:flex !important}
.navlinks{display:none !important}
.navlinks.open{display:flex !important;flex-basis:100%;flex-direction:column;align-items:flex-start;gap:0 !important;padding:4px 0 10px}
.hero,.heroin{min-height:460px !important}
.heroin{padding-top:88px !important;padding-bottom:40px !important}
.heroin figure{top:0 !important}
main section:not(.hero)[style*="padding-top"],main section:not(.hero) > div[style*="padding-top"]{padding-top:56px !important;padding-bottom:56px !important}
main h2[style*="clamp(3rem"]{font-size:2.5rem !important}
main h2[style*="clamp(2.6rem"]{font-size:2.2rem !important}
}
</style>
