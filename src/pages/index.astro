---
import Base from '../layouts/Base.astro';
---
<Base title="CourtsAbove · Worship songs from Sydney" description="CourtsAbove writes worship songs that reflect God's love. Listen to our debut single Eternal Word, and find free chords for your church." path="/" current="home">
<section class="hero" aria-label="Welcome" data-smoke-hero style="position: relative; min-height: 600px; display: flex; align-items: stretch; overflow: hidden; background: #16191D">
<div class="heroimg" style="position: absolute; inset: 0; overflow: hidden">
<img src="/images/home-hero.jpg" alt="Mount Fuji rising above the clouds, seen from the sky" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 78% 40%">
</div>
<div class="clouds clouds-a" aria-hidden="true"></div>
<div class="clouds clouds-b" aria-hidden="true"></div>
<div class="clouds clouds-c" aria-hidden="true"></div>
<div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,14,20,0.22) 0%, rgba(10,14,20,0.28) 50%, rgba(10,14,20,0.5) 100%)"></div>
<div class="smoke" aria-hidden="true" data-smoke></div>
<div class="heroin" style="position: relative; max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; width: 100%; box-sizing: border-box; min-height: 600px; padding-top: 96px; padding-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 36px">
<figure style="position: relative; top: 58px; margin: auto 0; max-width: 100%; display: flex; flex-direction: column; gap: 18px">
<h1 style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2rem, 3.6vw, 3.5rem); line-height: 1.2; letter-spacing: -0.015em; text-align: center; color: #FFFFFF; text-shadow: 0 2px 28px rgba(10,14,20,0.45)"><span class="ql">For a day in your courts is better</span> <span class="ql">than a thousand elsewhere.</span></h1>
<figcaption style="align-self: flex-end; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-style: italic; font-size: clamp(1.05rem, 1.5vw, 1.35rem); color: #E8EBEF">— Psalm 84:10</figcaption>
</figure>
<div class="socrow" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 20px">
<a href="https://open.spotify.com/album/54NkoKS9BHUDUuUEyp94kJ" aria-label="CourtsAbove on Spotify" title="Spotify" class="soc" style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: #FFFFFF; text-decoration: none; min-width: 76px">
<svg width="76" height="76" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="overflow: visible">
<defs><filter id="sk0" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="1" seed="3"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="1"></feDisplacementMap></filter></defs>
<circle class="skf" cx="28" cy="28" r="23" fill="rgba(10,14,20,0.22)" stroke="none"></circle>
<g filter="url(#sk0)">
<path class="skc" d="M28.5 4.2C41.8 3.6 52.6 13.4 52.1 27.6C51.7 41.3 41.9 52.4 27.8 52.2C13.6 52 3.7 41.6 4.1 27.4C4.5 14.1 13.9 4.9 31.2 5.1" stroke-width="1.5"></path>
<g transform="translate(11.5 11.5) rotate(-2 16.5 16.5) scale(1.375)" stroke-width="1.25"><circle cx="12" cy="12" r="9"></circle><path d="M7.5 9.5c3-1 6.5-.7 9 .8"></path><path d="M8 12.6c2.5-.7 5.3-.4 7.3.8"></path><path d="M8.6 15.4c2-.5 4-.3 5.6.6"></path></g>
</g>
</svg>
<span style="font-size: 12px; letter-spacing: 0.06em; color: #E8EBEF">Spotify</span></a>
<a href="https://www.youtube.com/@courtsabove" aria-label="CourtsAbove on YouTube" title="YouTube" class="soc" style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: #FFFFFF; text-decoration: none; min-width: 76px">
<svg width="76" height="76" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="overflow: visible">
<defs><filter id="sk2" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="1" seed="17"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="1"></feDisplacementMap></filter></defs>
<circle class="skf" cx="28" cy="28" r="23" fill="rgba(10,14,20,0.22)" stroke="none"></circle>
<g filter="url(#sk2)">
<path class="skc" d="M29.1 3.9C42.6 4.4 52.4 14.2 51.9 28.1C51.4 41.6 41.4 52.6 27.4 52.1C13.4 51.7 3.9 41.1 4.3 27.6C4.7 13.6 14.6 4.4 32 5.6" stroke-width="1.5"></path>
<g transform="translate(11.5 11.5) rotate(-1 16.5 16.5) scale(1.375)" stroke-width="1.25"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></g>
</g>
</svg>
<span style="font-size: 12px; letter-spacing: 0.06em; color: #E8EBEF">YouTube</span></a>
<a href="https://www.instagram.com/courtsabove" aria-label="CourtsAbove on Instagram" title="Instagram" class="soc" style="display: flex; flex-direction: column; align-items: center; gap: 4px; color: #FFFFFF; text-decoration: none; min-width: 76px">
<svg width="76" height="76" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="overflow: visible">
<defs><filter id="sk3" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="1" seed="24"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="1"></feDisplacementMap></filter></defs>
<circle class="skf" cx="28" cy="28" r="23" fill="rgba(10,14,20,0.22)" stroke="none"></circle>
<g filter="url(#sk3)">
<path class="skc" d="M27.8 4.3C41.9 3.9 52.7 13.9 52 28.3C51.3 42.2 41.2 52 27.3 52.3C13.2 52.5 4.5 41.9 4.4 27.9C4.3 14.3 14.1 4.9 30.4 4.7" stroke-width="1.5"></path>
<g transform="translate(11.5 11.5) rotate(2 16.5 16.5) scale(1.375)" stroke-width="1.25"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6"></circle></g>
</g>
</svg>
<span style="font-size: 12px; letter-spacing: 0.06em; color: #E8EBEF">Instagram</span></a>
</div>
</div>
</section>

<section id="newest" aria-labelledby="newest-h" style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 112px; padding-bottom: 112px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 64px; align-items: center">
<div style="display: flex; flex-direction: column; gap: 22px">
<h2 id="newest-h" style="margin: 0 0 0 -0.055em; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.12; letter-spacing: -0.01em">Latest Song</h2>
<p class="oneln" style="margin: -6px 0 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: 19px; line-height: 1.4; letter-spacing: -0.01em; color: #2F5683">Eternal Word <span aria-hidden="true" style="color: #5A5F66">·</span> <span style="color: #5A5F66">CourtsAbove’s first debut song</span></p>
<p class="dropcap" lang="en" style="margin: 0; max-width: 34em; font-size: 20px; line-height: 1.6; text-align: justify; hyphens: auto; text-wrap: pretty">A strong reflection on the beginning chapter of the Gospel of John. In ‘Eternal Word’ written by Daniel Chin, the mystery and identity of Jesus Christ as the Word of God is explored. <em>Eternal Word</em> calls for a response from the listener: to trust in the promises of God, and to follow Christ to His Cross.</p>
<div class="songbtns" style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 6px">
<a href="https://open.spotify.com/album/54NkoKS9BHUDUuUEyp94kJ" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; letter-spacing: 0.02em; background: #16191D; color: #FFFFFF; border: 1px solid #16191D"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M7.5 9.5c3-1 6.5-.7 9 .8"></path><path d="M8 12.6c2.5-.7 5.3-.4 7.3.8"></path><path d="M8.6 15.4c2-.5 4-.3 5.6.6"></path></svg><span>Listen on Spotify</span></a>
<a href="https://youtu.be/H4ZudKy-yEY" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; letter-spacing: 0.02em; background: transparent; color: #16191D; border: 1px solid #16191D"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg><span>Watch the Lyric Video</span></a>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 12px">
<a href="https://youtu.be/H4ZudKy-yEY" aria-label="Watch Eternal Word on YouTube" style="position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #16191D">
<img src="/images/lyric-video-thumb.jpg" alt="Daniel Chin singing Eternal Word beneath the timber roof of a church" style="width: 100%; height: 100%; object-fit: cover; display: block">
<span style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(10,14,20,0.18)"><span style="width: 84px; height: 84px; border-radius: 999px; background: rgba(255,255,255,0.94); color: #16191D; display: flex; align-items: center; justify-content: center; padding-left: 4px; box-sizing: border-box"><svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></span></span>
</a>
<p style="margin: 0; font-size: 14px; color: #5A5F66">Listen to the song here · YouTube</p>
</div>
</div>
</section>
<section aria-labelledby="write-h" style="background: #2F5683; color: #FFFFFF">
<div style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 104px; padding-bottom: 104px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 18px; max-width: 920px">
<p style="margin: 0; font-size: 13px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: #D6E2F0">Songwriters – Vocalists – Guitarists – or any Christian musician!</p>
<h2 id="write-h" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2.4rem, 5vw, 4.2rem); letter-spacing: -0.01em; line-height: 1.04"><span class="ql">Interested in writing</span> <span class="ql">your song with us?</span></h2>
<p style="margin: 0; font-size: 19px; color: #E8EEF6">If you’re a Christian musician that needs help, we’re always happy to chat about collaborating.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/contact/" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; background: #FFFFFF; color: #16191D; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg><span>Get in touch</span></a>
<a href="https://www.instagram.com/courtsabove" aria-label="CourtsAbove on Instagram" class="btn" style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; border-radius: 999px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6"></circle></svg></a>
<a href="https://www.facebook.com/CourtsAbove" aria-label="CourtsAbove on Facebook" class="btn" style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; border-radius: 999px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path></svg></a>
</div>
</div>
</section>
</Base>
<script>
  import '../scripts/smoke.js';
</script>
<style is:global>
@media (min-width: 760px){.ql{display:block;white-space:nowrap}}
.soc .skc,.soc .skf{opacity:0;transition:opacity .2s ease}
.soc:hover .skc,.soc:hover .skf,.soc:focus-visible .skc,.soc:focus-visible .skf{opacity:1}
@media (min-width: 1180px){.oneln{white-space:nowrap}}
.dropcap::first-letter{float:left;font-family:'Libre Baskerville',Baskerville,'Times New Roman',serif;font-size:4.6em;line-height:0.82;padding:0.06em 0.14em 0 0;margin-right:0.04em;color:#2F5683}
@media (max-width: 760px){
.menubtn{display:flex !important}
.navlinks{display:none !important}
.navlinks.open{display:flex !important;flex-basis:100%;flex-direction:column;align-items:flex-start;gap:0 !important;padding:4px 0 10px}
.hero,.heroin{min-height:460px !important}
.heroin{padding-top:88px !important;padding-bottom:40px !important}
.heroin figure{top:0 !important}
main section:not(.hero)[style*="padding-top"],main section:not(.hero) > div[style*="padding-top"]{padding-top:56px !important;padding-bottom:56px !important}
main h2[style*="clamp(3rem"]{font-size:2.5rem !important}
main h2[style*="clamp(2.6rem"]{font-size:2.2rem !important}
}
@media (max-width: 760px){
.socrow{flex-wrap:nowrap !important;gap:8px !important}
.soc{min-width:58px !important}
.soc svg{width:50px;height:50px}
.soc > span{font-size:11px !important;letter-spacing:0.02em !important;white-space:nowrap}
.songbtns{flex-wrap:nowrap !important;gap:8px !important}
.songbtns a{padding:0 12px !important;gap:5px !important;font-size:12px !important;letter-spacing:0 !important;white-space:nowrap;min-height:44px !important}
.songbtns svg{width:14px;height:14px;flex-shrink:0}
}
.clouds{position:absolute;top:0;bottom:0;left:0;width:200%;pointer-events:none;background-image:url(/images/clouds.webp);background-repeat:repeat-x;will-change:transform;-webkit-mask-image:linear-gradient(to bottom,transparent 4%,#000 22%,#000 64%,transparent 82%);mask-image:linear-gradient(to bottom,transparent 4%,#000 22%,#000 64%,transparent 82%)}
.clouds-a{background-size:50% 46%;background-position:0 38%;opacity:.32;animation:cloudDrift 150s linear infinite}
.clouds-b{background-size:50% 62%;background-position:0 52%;opacity:.2;animation:cloudDrift 260s linear infinite;animation-delay:-90s}
.clouds-c{background-size:50% 36%;background-position:0 24%;opacity:.18;animation:cloudDrift 200s linear infinite;animation-delay:-140s}
.heroimg{animation:heroBreathe 48s ease-in-out infinite alternate;transform-origin:78% 50%}
@keyframes cloudDrift{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes heroBreathe{from{transform:scale(1)}to{transform:scale(1.035)}}
@media (prefers-reduced-motion: reduce){.clouds,.heroimg{animation:none !important}}
@media (max-width: 760px){
.clouds-a{width:1520px !important;background-size:760px 190px !important}
.clouds-b{width:2000px !important;background-size:1000px 250px !important}
.clouds-c{width:1200px !important;background-size:600px 150px !important}
}
.smoke{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.puff{position:absolute;width:var(--s);height:var(--s);margin-left:calc(var(--s) * -.5);margin-top:calc(var(--s) * -.5);background-size:100% 100%;opacity:0;mix-blend-mode:screen;will-change:transform,opacity}
.pf1{background-image:url(/images/smoke-1.webp)}
.pf2{background-image:url(/images/smoke-2.webp)}
.pf3{background-image:url(/images/smoke-3.webp)}
.ra{animation:puffRiseA 3.4s cubic-bezier(.2,.6,.3,1) forwards}
.rb{animation:puffRiseB 3.4s cubic-bezier(.2,.6,.3,1) forwards}
@keyframes puffRiseA{0%{opacity:0;transform:translate(0,0) scale(.45) rotate(var(--r))}12%{opacity:.42}55%{opacity:.26}100%{opacity:0;transform:translate(var(--dx),calc(var(--rise) * -1)) scale(1.9) rotate(calc(var(--r) + 30deg))}}
@keyframes puffRiseB{0%{opacity:0;transform:translate(0,0) scale(.45) rotate(var(--r))}12%{opacity:.42}55%{opacity:.26}100%{opacity:0;transform:translate(var(--dx),calc(var(--rise) * -1)) scale(1.9) rotate(calc(var(--r) + 30deg))}}
@media (prefers-reduced-motion: reduce){.smoke{display:none}}
</style>
