---
import Base from '../layouts/Base.astro';
---
<Base title="Resources · CourtsAbove" description="Free chord charts, Nashville numbers and instrumental audio for music teams. Our songs are free for any church to sing." path="/resources/" current="resources">
<section class="hero" aria-labelledby="res-h" style="position: relative; min-height: 600px; display: flex; align-items: stretch; overflow: hidden; background: #16191D">
<img src="/images/resources-hero.jpg" alt="Leading worship together on the grass by the river" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%">
<div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,14,20,0.22) 0%, rgba(10,14,20,0.28) 50%, rgba(10,14,20,0.5) 100%)"></div>
<div class="heroin" style="position: relative; max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; width: 100%; box-sizing: border-box; min-height: 600px; padding-top: 96px; padding-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 36px">
<figure style="margin: auto 0; max-width: 100%; display: flex; flex-direction: column; gap: 18px">
<h1 id="res-h" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2rem, 3.6vw, 3.5rem); line-height: 1.2; letter-spacing: -0.015em; text-align: center; color: #FFFFFF; text-shadow: 0 2px 28px rgba(10,14,20,0.45)"><span class="ql">For your church’s music team.</span></h1>
<figcaption style="align-self: flex-end; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-style: italic; font-size: clamp(1.05rem, 1.5vw, 1.35rem); color: #E8EBEF">— Resources</figcaption>
</figure>
</div>
</section>

<section aria-labelledby="intro-h" style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 104px; padding-bottom: 72px">
<div style="display: flex; flex-direction: column; gap: 22px; max-width: 680px">
<h2 id="intro-h" style="margin: 0 0 0 -0.055em; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(3rem, 6vw, 5rem); line-height: 1.12; letter-spacing: -0.015em">Resources</h2>
<p style="margin: -6px 0 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: 19px; line-height: 1.4; letter-spacing: -0.01em; color: #2F5683">For music teams <span aria-hidden="true" style="color: #5A5F66">·</span> <span style="color: #5A5F66">Free to download and share</span></p>
</div>
</section>

<section aria-labelledby="pack-h" style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-bottom: 96px">
<div style="display: flex; flex-wrap: wrap; gap: 48px; padding-top: 56px; border-top: 1px solid #D9D6CE; align-items: flex-start">
<div style="flex: 0 1 auto; display: flex; gap: 20px; align-items: center">
<img src="/images/eternal-word-cover.jpg" alt="Eternal Word artwork" style="width: 120px; height: 120px; object-fit: cover; border-radius: 4px; flex-shrink: 0">
<div style="display: flex; flex-direction: column; gap: 4px">
<h2 id="pack-h" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.3rem); letter-spacing: -0.01em; line-height: 1.15; white-space: nowrap">Eternal Word</h2>
<p style="margin: 0; font-size: 15px; color: #5A5F66">Song pack</p>
</div>
</div>
<div style="flex: 2 1 560px; min-width: 0"><div style="line-height: 1.5; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px">
<a href="https://open.spotify.com/album/54NkoKS9BHUDUuUEyp94kJ" class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 14px 20px; border-radius: 6px; text-decoration: none; box-sizing: border-box; border: 1px solid #D9D6CE; background: #FFFFFF; color: #16191D"><span style="display: flex; flex-direction: column"><span style="font-weight: 500">Listen on Spotify</span><span style="font-size: 14px; color: #5A5F66">Opens Spotify</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M7.5 9.5c3-1 6.5-.7 9 .8"></path><path d="M8 12.6c2.5-.7 5.3-.4 7.3.8"></path><path d="M8.6 15.4c2-.5 4-.3 5.6.6"></path></svg></a>
<a href="/songs/eternal-word/chords/" class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 14px 20px; border-radius: 6px; text-decoration: none; box-sizing: border-box; border: 1px solid #D9D6CE; background: #FFFFFF; color: #16191D"><span style="display: flex; flex-direction: column"><span style="font-weight: 500">Chords &amp; Lyrics</span><span style="font-size: 14px; color: #5A5F66">Transpose &amp; Nashville numbers</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
<div aria-disabled="true" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 14px 20px; border-radius: 6px; text-decoration: none; box-sizing: border-box; border: 1px dashed #C9C5BB; background: transparent; color: #5A5F66; cursor: default"><span style="display: flex; flex-direction: column"><span style="font-weight: 500">Instrumental Audio</span><span style="font-size: 14px; color: #5A5F66">Coming soon</span></span></div>
</div></div>
</div>
</section>

<section aria-labelledby="use-h" style="background: #FFFFFF; border-top: 1px solid #D9D6CE; border-bottom: 1px solid #D9D6CE">
<div style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 96px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 32px 56px">
<div style="display: flex; flex-direction: column; gap: 14px">
<h2 id="use-h" style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.12; letter-spacing: -0.01em; color: #16191D">Free to Sing.</h2>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 18px; font-weight: 600">In your services</h3>
<p style="margin: 0; color: #5A5F66">We are not registered with CCLI yet, so our songs are free for any church to use. Please include our name in your credits.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 18px; font-weight: 600">Covers and uploads</h3>
<p style="margin: 0; color: #5A5F66">Yes, please! Credit CourtsAbove and tag <a href="https://www.instagram.com/courtsabove">@courtsabove</a> so we can see and share it.</p>
</div>
<div style="display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 18px; font-weight: 600">Suggested credit line</h3>
<p style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: 20px; line-height: 1.4; letter-spacing: -0.01em">Eternal Word — CourtsAbove</p>
</div>
</div>
</section>

<section aria-label="More resources" style="max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; padding-top: 96px; padding-bottom: 112px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: center">
<img src="/images/more-songs.jpg" alt="Leading songs together outdoors with a guitar and music stand" style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; border-radius: 4px">
<div style="display: flex; flex-direction: column; gap: 18px">
<h2 style="margin: 0; font-family: 'Libre Baskerville', Baskerville, 'Times New Roman', serif; font-weight: 400; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1.12; letter-spacing: -0.01em; color: #16191D">More songs on the way.</h2>
<p style="margin: 0; color: #5A5F66">New chord charts and recordings will be added here as each song is released. Follow along on our socials to hear first.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px"><a href="https://open.spotify.com/album/54NkoKS9BHUDUuUEyp94kJ" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; letter-spacing: 0.02em; background: #16191D; color: #FFFFFF; border: 1px solid #16191D"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M7.5 9.5c3-1 6.5-.7 9 .8"></path><path d="M8 12.6c2.5-.7 5.3-.4 7.3.8"></path><path d="M8.6 15.4c2-.5 4-.3 5.6.6"></path></svg><span>Follow on Spotify</span></a><a href="https://www.instagram.com/courtsabove" class="btn" style="display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; letter-spacing: 0.02em; background: transparent; color: #16191D; border: 1px solid #16191D"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6"></circle></svg><span>Follow on Instagram</span></a></div>
</div>
</div>
</section>
</Base>
<style is:global>
@media (min-width: 760px){.ql{display:block;white-space:nowrap}}
@media (max-width: 760px){
.menubtn{display:flex !important}
.navlinks{display:none !important}
.navlinks.open{display:flex !important;flex-basis:100%;flex-direction:column;align-items:flex-start;gap:0 !important;padding:4px 0 10px}
.hero,.heroin{min-height:460px !important}
.heroin{padding-top:88px !important;padding-bottom:40px !important}
.heroin figure{top:0 !important}
main section:not(.hero)[style*="padding-top"],main section:not(.hero) > div[style*="padding-top"]{padding-top:56px !important;padding-bottom:56px !important}
main h2[style*="clamp(3rem"]{font-size:2.5rem !important}
main h2[style*="clamp(2.6rem"]{font-size:2.2rem !important}
}
</style>
